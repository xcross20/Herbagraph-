# Copy these into Railway → web service → Variables (and repeat on worker).
# Use "Add variable reference" for Postgres/Redis where noted.

# ── Required: database (pick ONE source) ──
# Option A — Railway Postgres in same project (recommended):
DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
# Option B — Supabase Postgres (Settings → Database → URI → Session pooler, port 6543):
# IMPORTANT: Do NOT use "Direct connection" (db.*.supabase.co) — IPv6-only, fails on Railway.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# URL-encode special characters in the password (@ → %40, # → %23, etc.)

# Required on WEB + WORKER (add Redis database in Railway project first).
# In Variables → Add Reference → pick your Redis service → REDIS_URL
# Service name must match: if Redis box is named "Redis", use ${{Redis.REDIS_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Required to encrypt uploaded lab files at rest (same value on web + worker)
ENCRYPTION_KEY=run: python scripts/generate_encryption_key.py

AUTH_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
ALLOW_GUEST_AUTH=false
SIGNUP_ACCESS_CODE=19922026
DEBUG=false
CORS_ORIGINS=https://www.herbagraph.com

SECRET_KEY=generate-with-scripts/generate_production_secrets.sh
ENCRYPTION_KEY=generate-with-scripts/generate_production_secrets.sh

ADMIN_EMAILS=you@yourdomain.com
ADMIN_MASTER_PASSWORD=generate-with-scripts/generate_production_secrets.sh

LLM_PROVIDER=minimax
MINIMAX_API_KEY=...
LLM_MODEL=MiniMax-M2.7
HERBAGRAPH_CATALOG_ONLY_REASONING=0