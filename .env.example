# ── Database (never commit real credentials) ──
DATABASE_URL=postgresql+asyncpg://herbagraph:herbagraph@localhost:5432/herbagraph

# ── Secrets (generate unique values per environment; never commit .env) ──
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ENCRYPTION_KEY=
OPENAI_API_KEY=
NCBI_API_KEY=

# ── Auth ──
# local = bcrypt JWT (sandbox/dev)  |  supabase = Supabase Auth (production)
AUTH_PROVIDER=local
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_GUEST_AUTH=true

# Supabase (required when AUTH_PROVIDER=supabase)
# Create project at https://supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Admin dashboard access (comma-separated emails)
ADMIN_EMAILS=

# ── App ──
LLM_MODEL=gpt-4o
REDIS_URL=redis://localhost:6379/0
NCBI_EMAIL=dev@herbagraph.io
UPLOAD_DIR=/tmp/herbagraph/uploads
MAX_FILE_SIZE_MB=10
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
DEIDENTIFY_BEFORE_LLM=true
HERBAGRAPH_CATALOG_ONLY_REASONING=0

# Legacy stubs (unused)
CLERK_SECRET_KEY=
FIREBASE_PROJECT_ID=