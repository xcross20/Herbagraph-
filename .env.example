# ── Database (never commit real credentials) ──
DATABASE_URL=postgresql+asyncpg://herbagraph:herbagraph@localhost:5432/herbagraph

# ── Secrets (generate unique values per environment; never commit .env) ──
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ENCRYPTION_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
NCBI_API_KEY=

# ── Auth ──
# local = bcrypt JWT (sandbox/dev)  |  supabase = Supabase Auth (production)
AUTH_PROVIDER=local
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_GUEST_AUTH=true

# Supabase (required when AUTH_PROVIDER=supabase)
# Create project at https://supabase.com → Settings → API
SUPABASE_URL=
# Legacy anon JWT key (eyJ...) or new publishable key (sb_publishable_...)
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Optional — only needed for legacy HS256 projects; ES256 uses JWKS automatically
SUPABASE_JWT_SECRET=

# Admin console access (comma-separated emails) — /admin/ and /admin/users.html
ADMIN_EMAILS=

# ── App ──
# LLM_PROVIDER=openai  |  minimax (OpenAI-compatible — https://api.minimax.io/v1)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0
LLM_STABILIZE_REASONING=true
# When LLM_PROVIDER=minimax:
#   LLM_MODEL=MiniMax-M2.7
#   MINIMAX_API_KEY=your_minimax_secret
# Optional PDF vision model (M2.x is text-only; use MiniMax-M3 for scanned PDFs):
# LLM_VISION_MODEL=MiniMax-M3
REDIS_URL=redis://localhost:6379/0
NCBI_EMAIL=dev@herbagraph.io
UPLOAD_DIR=/tmp/herbagraph/uploads
MAX_FILE_SIZE_MB=10
DEBUG=false
# Required in production when DEBUG=false (comma-separated, include https://yourdomain.com)
CORS_ORIGINS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
DEIDENTIFY_BEFORE_LLM=true
HERBAGRAPH_CATALOG_ONLY_REASONING=0

# Legacy stubs (unused)
CLERK_SECRET_KEY=
FIREBASE_PROJECT_ID=